FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WHISPER_MODEL=small

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.gpu.txt ./

# The CUDA wheel bundles user-space CUDA libraries. Docker's NVIDIA runtime supplies
# the host driver when this image is started with GPU access.
RUN pip install --no-cache-dir --upgrade -r requirements.gpu.txt

COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
