# Image names pushed to a registry reachable by all Swarm nodes.
API_IMAGE=registry.example.com/meeting-mgnt-api:0.1.0
WEB_IMAGE=registry.example.com/meeting-mgnt-web:0.1.0

# Public site. Use http://:80 for an IP-only pilot, or meeting.example.com for Caddy-managed HTTPS.
APP_SITE=http://:80

# Service scale.
CADDY_REPLICAS=1
API_REPLICAS=2

# API runtime.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=100
TRUST_PROXY=true
JWT_SECRET=replace-with-production-secret
JWT_EXPIRES_IN=7d

# External production services.
# For pilot-stack.yml, these can point to the in-stack services shown below.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_mgnt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_mgnt

REDIS_URL=redis://redis:6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_FILES=meeting-files
MINIO_BUCKET_AUDIO=meeting-audio
