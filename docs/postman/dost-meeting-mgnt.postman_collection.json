{
  "info": {
    "name": "DOST Meeting Management",
    "description": "Auth, Meeting CRUD, and Participant management endpoints for the DOST meeting management API. Run **Login** first to populate the `token` collection variable; subsequent requests use it via Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "dost-meeting-mgnt-collection"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "meetingId", "value": "", "type": "string" },
    { "key": "participantUserId", "value": "", "type": "string" },
    { "key": "fileId", "value": "", "type": "string" },
    { "key": "actionItemId", "value": "", "type": "string" },
    { "key": "email", "value": "smoke@test.local", "type": "string" },
    { "key": "password", "value": "password123", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Creates a new user. Returns `{ token, user }` and sets the `token` collection variable on success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Returns `{ token, user }`. Test script auto-saves `token` to the collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Returns the user attached to the current bearer token."
          }
        }
      ]
    },
    {
      "name": "Meetings",
      "item": [
        {
          "name": "Create meeting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/meetings", "host": ["{{baseUrl}}"], "path": ["meetings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sprint planning\",\n  \"description\": \"Plan the next sprint backlog\",\n  \"startsAt\": \"2026-05-01T09:00:00+10:00\",\n  \"endsAt\": \"2026-05-01T10:00:00+10:00\",\n  \"timezoneName\": \"Australia/Brisbane\",\n  \"location\": \"Room 4.1\",\n  \"status\": \"scheduled\",\n  \"department\": \"engineering\"\n}"
            },
            "description": "Creates a meeting. `startsAt`/`endsAt` accept ISO 8601 with offset; Postgres normalizes to UTC. `timezoneName` defaults to `'UTC'` if omitted; must be a valid IANA zone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.meeting && data.meeting.id) pm.collectionVariables.set('meetingId', data.meeting.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List meetings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Returns `{ meetings: [...] }` plus pagination headers:\n- `X-Total-Count`: total matching rows\n- `Link` (RFC 5988): `first`, `last` always; `prev`/`next` at boundaries; preserves filter query params."
          }
        },
        {
          "name": "List meetings (filters + pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings?status=scheduled&department=engineering&from=2026-05-01T00:00:00Z&to=2026-05-31T23:59:59Z&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"],
              "query": [
                { "key": "status", "value": "scheduled", "description": "scheduled | in_progress | completed | cancelled" },
                { "key": "department", "value": "engineering" },
                { "key": "from", "value": "2026-05-01T00:00:00Z", "description": "ISO 8601; starts_at >= from" },
                { "key": "to", "value": "2026-05-31T23:59:59Z", "description": "ISO 8601; starts_at <= to" },
                { "key": "page", "value": "1", "description": "default 1, min 1" },
                { "key": "limit", "value": "10", "description": "default 20, min 1, max 100" }
              ]
            }
          }
        },
        {
          "name": "Get meeting by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}"]
            }
          }
        },
        {
          "name": "Update meeting",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"location\": \"Room 5.2\"\n}"
            },
            "description": "Partial update — send only the fields you want to change."
          }
        },
        {
          "name": "Delete meeting",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}"]
            },
            "description": "Hard delete. Returns 204 on success, 404 if not found."
          }
        }
      ]
    },
    {
      "name": "Participants",
      "description": "Manage participants on a meeting. All requests target `/meetings/{{meetingId}}/participants`. Only the meeting creator or a participant with `role='organizer'` can add / update / remove participants. The last organizer cannot be demoted or removed.",
      "item": [
        {
          "name": "List participants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/participants",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "participants"]
            },
            "description": "Returns `{ participants: [...] }`. Each row includes `userId`, `name`, `email`, `role`, `rsvpStatus`, `addedBy`, `addedAt`. Also available nested on `GET /meetings/{{meetingId}}`."
          }
        },
        {
          "name": "Add participants (bulk)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/participants",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "participants"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIds\": [\"<user-uuid-1>\", \"<user-uuid-2>\"],\n  \"role\": \"attendee\"\n}"
            },
            "description": "Adds one or more users to the meeting. `userIds` is a 1–50 element array of user UUIDs. `role` is optional (default `attendee`); allowed: `organizer`, `attendee`, `optional`.\n\nIdempotent — re-posting an existing `userId` is a no-op (use PATCH to change role). Returns `201 { participants }` containing the current rows for every requested id.\n\nThe test script auto-saves the first returned `userId` to `participantUserId` so the PATCH/DELETE requests below work out of the box."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.participants && data.participants.length > 0) {",
                  "    pm.collectionVariables.set('participantUserId', data.participants[0].userId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update participant (role / RSVP)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/participants/{{participantUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "participants", "{{participantUserId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"organizer\",\n  \"rsvpStatus\": \"accepted\"\n}"
            },
            "description": "Update a participant's `role` and/or `rsvpStatus`. At least one field is required (empty body returns 400).\n\nAllowed `role`: `organizer`, `attendee`, `optional`.\nAllowed `rsvpStatus`: `pending`, `accepted`, `declined`.\n\nDemoting the last organizer returns 400."
          }
        },
        {
          "name": "Remove participant",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/participants/{{participantUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "participants", "{{participantUserId}}"]
            },
            "description": "Removes the participant from the meeting. Returns 204 on success, 404 if not a participant, 400 if they are the last organizer."
          }
        }
      ]
    },
    {
      "name": "RSVP",
      "description": "Self-service RSVP. The authenticated user must be a participant on the target meeting.",
      "item": [
        {
          "name": "Update my RSVP",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/rsvp",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "rsvp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rsvpStatus\": \"accepted\"\n}"
            },
            "description": "Set the authenticated user's RSVP on the meeting to `accepted` or `declined`. Self-reset to `pending` is rejected (400). Non-participants get 403."
          }
        }
      ]
    },
    {
      "name": "Files",
      "description": "Upload, list, download, and delete files attached to a meeting. Upload/delete requires creator or organizer role; list/download requires any participant role. Max 50 MB; allowed types: PDF, DOCX, XLSX, PPTX, PNG, JPEG, GIF, WEBP.",
      "item": [
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "files"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "", "description": "Select a PDF/DOCX/XLSX/PPTX/image ≤ 50 MB" },
                { "key": "description", "value": "Meeting agenda", "type": "text", "description": "Optional description" }
              ]
            },
            "description": "Multipart upload. Field name must be `file`. Returns `201 { file }`. Auto-saves `fileId` to collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.file && data.file.id) pm.collectionVariables.set('fileId', data.file.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "files"]
            },
            "description": "Returns `{ files: [...] }` for the meeting. Any participant can list."
          }
        },
        {
          "name": "Download file (presigned URL)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}", "download"]
            },
            "description": "Returns `{ url, expiresAt }`. The presigned URL is valid for 60 seconds — paste it into a browser or use it in a fetch to retrieve the file bytes directly from MinIO."
          }
        },
        {
          "name": "Delete file",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}"]
            },
            "description": "Hard delete — removes the DB row and the MinIO object. Returns 204. Only creator or organizer can delete."
          }
        }
      ]
    },
    {
      "name": "Action items",
      "description": "Create, list, update, and delete action items attached to a meeting. Any meeting participant (including the creator) can CRUD action items.",
      "item": [
        {
          "name": "Create action item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/action-items",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "action-items"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write the design doc\",\n  \"description\": \"Capture decisions from today\",\n  \"assigneeId\": \"<user-uuid>\",\n  \"dueDate\": \"2026-05-10T17:00:00+10:00\",\n  \"priority\": \"high\"\n}"
            },
            "description": "Creates an action item. `title` is required (≤255 chars). `assigneeId`, `dueDate`, `description`, `priority` are optional. Defaults: `status='todo'`, `priority='medium'`, `source='manual'`. Auto-saves `actionItemId` to collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.actionItem && data.actionItem.id) pm.collectionVariables.set('actionItemId', data.actionItem.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List action items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/action-items?status=todo",
              "host": ["{{baseUrl}}"],
              "path": ["meetings", "{{meetingId}}", "action-items"],
              "query": [
                { "key": "status", "value": "todo", "description": "Optional: todo | in_progress | blocked | completed | cancelled", "disabled": true },
                { "key": "assigneeId", "value": "", "description": "Optional: filter to items assigned to a user", "disabled": true }
              ]
            },
            "description": "Returns `{ actionItems: [...] }` ordered by `createdAt DESC`. Supports optional `status` and `assigneeId` query filters."
          }
        },
        {
          "name": "Update action item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/action-items/{{actionItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["action-items", "{{actionItemId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"priority\": \"high\"\n}"
            },
            "description": "Partial update — send only the fields to change. Allowed: `title`, `description`, `assigneeId`, `dueDate`, `status`, `priority`. Empty body returns 400. Transitioning `status` to `completed` stamps `completedAt`; transitioning away clears it."
          }
        },
        {
          "name": "Delete action item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/action-items/{{actionItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["action-items", "{{actionItemId}}"]
            },
            "description": "Hard delete. Returns 204 on success, 404 if not found. Any meeting participant can delete."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/../health/live", "host": ["{{baseUrl}}"], "path": ["..", "health", "live"] }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/../health/ready", "host": ["{{baseUrl}}"], "path": ["..", "health", "ready"] }
          }
        }
      ]
    }
  ]
}
