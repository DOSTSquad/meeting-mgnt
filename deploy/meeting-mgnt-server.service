[Unit]
Description=DOST Meeting Management Express API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=meeting-mgnt
Group=meeting-mgnt
WorkingDirectory=/srv/meeting-mgnt
EnvironmentFile=/srv/meeting-mgnt/.env
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
