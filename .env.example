# Server
NODE_ENV=development
PORT=3001
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=100
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_mgnt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_mgnt

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_FILES=meeting-files
MINIO_BUCKET_AUDIO=meeting-audio

# Auth
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Email provider (smtp or resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Meeting Management <meeting-service@gmail.com>"
CLIENT_URL=http://localhost:5173
INVITATION_TOKEN_TTL_DAYS=7

# SMTP provider (for Gmail, use a Google App Password, never the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=meeting-service@gmail.com
SMTP_PASSWORD=replace-with-google-app-password

# Resend provider (requires a verified sending domain)
RESEND_API_KEY=replace-with-resend-api-key

# Client
VITE_API_BASE_URL=http://localhost:3001
