# Server
NODE_ENV=development
PORT=3001
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=100
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_mgnt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_mgnt

# Redis
REDIS_URL=redis://localhost:6379

# AI workflow. Run the server worker and `python -m app.worker` when enabled.
AI_PIPELINE_ENABLED=false
AI_TRANSCRIPTION_STREAM=ai.transcription.jobs
AI_ANALYSIS_STREAM=ai.analysis.jobs
AI_RESULT_STREAM=ai.results
AI_RESULT_CONSUMER_GROUP=server-result-consumers
AI_RESULT_CONSUMER_NAME=
AI_TRANSCRIPTION_CONSUMER_GROUP=whisper-workers
AI_ANALYSIS_CONSUMER_GROUP=analysis-workers
AI_STREAM_MAXLEN=10000
AI_STREAM_READ_BLOCK_MS=1000
AI_STREAM_CLAIM_IDLE_MS=60000
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_DELAY_SECONDS=5
AI_JOB_LOCK_TTL_SECONDS=3600
WORKFLOW_OUTBOX_DISPATCH_INTERVAL_MS=5000
WORKFLOW_OUTBOX_DISPATCH_LIMIT=25
WORKFLOW_OUTBOX_LEASE_SECONDS=60
WORKFLOW_OUTBOX_RETRY_DELAY_SECONDS=30
WORKFLOW_STATUS_CHANNEL=workflow:recording-status
WORKFLOW_SSE_HEARTBEAT_MS=15000
# Fixture providers are for local/test slices only. Production requires the unsafe override.
# The worker refuses to start without a transcription provider; it never defaults to fixture.
AI_TRANSCRIPTION_PROVIDER=fixture
AI_ANALYSIS_PROVIDER=fixture
ALLOW_UNSAFE_FIXTURE_PROVIDERS=false
# Used only when AI_TRANSCRIPTION_PROVIDER=whisper.
AI_TRANSCRIPTION_LANGUAGE=en
# Used only when AI_ANALYSIS_PROVIDER=llm. Falls back to the transcription language.
AI_ANALYSIS_LANGUAGE=en
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=1200
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
# Host-facing default; Compose overrides this with the `ollama` service name.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_FILES=meeting-files
MINIO_BUCKET_AUDIO=meeting-audio
MINIO_BUCKET_AI_RESULTS=meeting-ai-results

# Auth
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Email provider (smtp or resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Meeting Management <meeting-service@gmail.com>"
CLIENT_URL=http://localhost:5173
INVITATION_TOKEN_TTL_DAYS=7

# SMTP provider (for Gmail, use a Google App Password, never the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=meeting-service@gmail.com
SMTP_PASSWORD=replace-with-google-app-password

# Resend provider (requires a verified sending domain)
RESEND_API_KEY=replace-with-resend-api-key

# Client
VITE_API_BASE_URL=http://localhost:3001
